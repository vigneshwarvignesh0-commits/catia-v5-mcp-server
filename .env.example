# ============================================================
# CATIA V5 MCP Server – Environment Variables
# ============================================================
# Copy this file to .env in the project root and fill in your values.
# NEVER commit .env to version control.

# ── Authentication ───────────────────────────────────────────
# Single bearer token (simplest setup):
MCP_AUTH_TOKEN=your-secret-token-here

# Multiple bearer tokens (comma-separated, for multiple clients):
# MCP_AUTH_TOKENS=token-for-antigravity,token-for-claude,token-for-opencode

# ── HTTP Server Binding ──────────────────────────────────────
# Bind to localhost only (safe default – tunnel provides external access)
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_ENDPOINT=/mcp

# ── Timeouts ─────────────────────────────────────────────────
# Maximum seconds per CATIA tool call (default 120)
MCP_TOOL_TIMEOUT=120

# Session idle timeout in seconds (default 1800 = 30 minutes)
MCP_SESSION_IDLE_TIMEOUT=1800

# ── Logging ───────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
MCP_LOG_LEVEL=INFO

# Log file path (default: catia_mcp_http.log in project root)
# MCP_LOG_FILE=C:\path\to\catia_mcp_http.log

# ── CATIA Connection ──────────────────────────────────────────
# Automatically connect to CATIA when HTTP server starts (default: false)
# Set to true if you want CATIA to connect immediately on server startup
CATIA_CONNECT_ON_START=false
